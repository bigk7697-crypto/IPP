# Supabase — projet Site Scolaire (à remplir, JAMAIS commiter le .env réel)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SECRET serveur uniquement — jamais au frontend, jamais dans Git
SUPABASE_SERVICE_ROLE_KEY=

# Optionnel : secret pour vérif webhooks futures (non utilisé V1)
JWT_SECRET=

PORT=4000
# CORS : origines autorisées séparées par virgule
# dev : http://localhost:5173,http://localhost:3000
# prod : https://www.ecole.com,https://admin.ecole.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Environnement
NODE_ENV=development
